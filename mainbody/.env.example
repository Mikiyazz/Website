# Copy to .env; generate separate random values before starting containers.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-random-key-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 生产 HTTPS/HTTP 协议开关（仅在 DJANGO_SETTINGS_MODULE=config.settings.production 时生效）：
# - 独立 HTTPS 证书（配合 NGINX_CONF_FILE=./deploy/nginx.https.conf）或学校前置 HTTPS 网关（./deploy/nginx.gateway.conf）：保持 true
# - 矿大校内纯 HTTP 内网无证书部署（配合默认 ./deploy/nginx.conf）：改为 false，彻底避免无限 301 重定向
DJANGO_USE_HTTPS=true
# 可选细粒度覆盖（默认继承 DJANGO_USE_HTTPS）：
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Nginx 模板与 X-Accel-Redirect 下载卸载（生产模式默认 true；本机 runserver 保持 false）
NGINX_CONF_FILE=./deploy/nginx.conf
NGINX_ACCEL_REDIRECT_ENABLED=false
NGINX_ACCEL_REDIRECT_PREFIX=/internal-media

POSTGRES_DB=practice
POSTGRES_USER=practice
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://practice:replace-with-a-random-password@127.0.0.1:5432/practice
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_DEFAULT_TIMEOUT=300
WEB_PORT=8080
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
# 矿大服务器大容量数据盘根路径（配合 compose.prod.yaml 使用，例如 /data/practice-platform）
DATA_ROOT=/data/practice-platform

# 10 GB in decimal bytes. A single file can never exceed this ceiling.
MAX_FILE_BYTES=10000000000
UPLOAD_PART_BYTES=33554432
MAX_ACTIVE_UPLOADS_PER_USER=2
# 上传与导出前磁盘最低保留空间（默认 5 GiB = 5368709120 字节），低于该值拒绝新写入并报错告警
UPLOAD_MIN_FREE_DISK_BYTES=5368709120
# 异步导出归档 ZIP 保留时长（小时，默认 72 小时后由 dispatcher/维护命令自动清理）
EXPORT_RETENTION_HOURS=72
STORAGE_BACKEND=disabled
# 审计取证：默认只信 REMOTE_ADDR；确认部署在可信反代（Nginx/Traefik）之后才设 true，
# 否则攻击者自带 X-Forwarded-For 就能把审计 IP 写歪。
TRUST_X_FORWARDED_FOR=false
# 视频容器探测：默认留空关闭耗时的外部 ffprobe 探测（保留魔数 + 扩展名 + 大小校验）。
# 仅在确实需要深度视频流探测且镜像内已安装 ffmpeg 时显式配置，例如 /usr/bin/ffprobe。
UPLOAD_FFPROBE_BIN=
# Configure only after implementing the storage adapter; never expose secrets in JS.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
