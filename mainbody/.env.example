# Copy to .env; generate separate random values before starting containers.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-random-key-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=practice
POSTGRES_USER=practice
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://practice:replace-with-a-random-password@127.0.0.1:5432/practice
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
WEB_PORT=8080
# 10 GB in decimal bytes. A single file can never exceed this ceiling.
MAX_FILE_BYTES=10000000000
UPLOAD_PART_BYTES=33554432
MAX_ACTIVE_UPLOADS_PER_USER=2
STORAGE_BACKEND=disabled
# 审计取证：默认只信 REMOTE_ADDR；确认部署在可信反代（Nginx/Traefik）之后才设 true，
# 否则攻击者自带 X-Forwarded-For 就能把审计 IP 写歪。
TRUST_X_FORWARDED_FOR=false
# 视频容器探测：ffprobe 可执行名或绝对路径，例如 /usr/bin/ffprobe。
# 留空 = 关闭探测（降级为魔数+大小校验），生产建议配上。
UPLOAD_FFPROBE_BIN=ffprobe
# Configure only after implementing the storage adapter; never expose secrets in JS.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
